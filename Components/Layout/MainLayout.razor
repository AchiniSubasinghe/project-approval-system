@inherits LayoutComponentBase

@using project_approval_system.Components.Shared.Chatbot

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Blind-Match PAS</MudText>
        <MudSpacer />
        <AuthorizeView Context="authCtx">
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-3">@authCtx.User.Identity!.Name</MudText>
                <MudTooltip Text="Assistant">
                    <MudIconButton Icon="@Icons.Material.Filled.SmartToy"
                                   Color="Color.Inherit"
                                   OnClick="() => _chatOpen = !_chatOpen" />
                </MudTooltip>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/Account/Logout" StartIcon="@Icons.Material.Filled.Logout">
                    Sign out
                </MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/Account/Login">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer Open="true" Variant="DrawerVariant.Responsive" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
    <AuthorizeView>
        <Authorized>
            <ChatDrawer @bind-Open="_chatOpen" />
        </Authorized>
    </AuthorizeView>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _chatOpen;
}
