@page "/"

<PageTitle>Blind-Match PAS</PageTitle>

<MudStack Spacing="4">
    <MudText Typo="Typo.h3">Welcome to Blind-Match</MudText>
    <MudText Typo="Typo.body1">
        A fair, interest-driven platform for pairing students with final-year project supervisors.
        Students submit proposals anonymously; supervisors select projects that match their expertise.
    </MudText>
    <AuthorizeView>
        <Authorized>
            <MudStack Row="true" Spacing="2">
                <AuthorizeView Roles="Student" Context="studentCtx">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/student">
                        Go to My Proposals
                    </MudButton>
                </AuthorizeView>
            </MudStack>
        </Authorized>
        <NotAuthorized>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Account/Login">
                    Sign in
                </MudButton>
            </MudStack>
        </NotAuthorized>
    </AuthorizeView>
</MudStack>
