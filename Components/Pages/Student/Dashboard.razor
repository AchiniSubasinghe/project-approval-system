@page "/student"
@layout Layout.MainLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using project_approval_system.Data
@using project_approval_system.Services
@attribute [Authorize(Roles = Roles.Student)]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IProjectMatchingService Matching
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>My Proposals</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4">My Proposals</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Submit ideas, follow review progress, and open matched supervisor details.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/student/proposal/new"))">
            New proposal
        </MudButton>
    </MudStack>

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.overline">Total Proposals</MudText>
                    <MudText Typo="Typo.h5">@ProposalCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.overline">In Review</MudText>
                    <MudText Typo="Typo.h5">@ActiveProposalCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.overline">Matched</MudText>
                    <MudText Typo="Typo.h5">@MatchedProposalCount</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.overline">Withdrawn</MudText>
                    <MudText Typo="Typo.h5">@WithdrawnProposalCount</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (ProposalCount == 0)
        {
            <MudAlert Severity="Severity.Info">
                Start by submitting a proposal with a clear abstract, technical stack, and research area.
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/student/proposal/new">Create proposal</MudButton>
            </MudAlert>
        }
        else if (LatestMatchedProposal is not null)
        {
            <MudAlert Severity="Severity.Success">
                Your proposal "@LatestMatchedProposal.Title" has been matched. Open it to view the revealed supervisor details.
                <MudButton Variant="Variant.Text" Color="Color.Success" Href="@($"/student/proposal/{LatestMatchedProposal.Id}")">View match</MudButton>
            </MudAlert>
        }
        else if (LatestActiveProposal is not null)
        {
            <MudAlert Severity="Severity.Info">
                Your latest active proposal is still available for supervisor review. You can edit or withdraw it until it is matched.
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/student/proposal/{LatestActiveProposal.Id}")">Review status</MudButton>
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning">
                All submitted proposals are withdrawn. Submit a new proposal when you are ready for review.
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/student/proposal/new">New proposal</MudButton>
            </MudAlert>
        }

        @if (proposals.Count == 0)
        {
            <MudAlert Severity="Severity.Info">You have not submitted any proposals yet.</MudAlert>
        }
        else
        {
            <MudTable Items="proposals" Hover="true" Dense="false" Striped="true">
                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Research Area</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Updated</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Title">@context.Title</MudTd>
                    <MudTd DataLabel="Research Area">@context.ResearchArea.Name</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Updated">@context.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                       OnClick="@(() => Navigation.NavigateTo($"/student/proposal/{context.Id}"))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Disabled="@(!CanEdit(context.Status))"
                                       OnClick="@(() => Navigation.NavigateTo($"/student/proposal/{context.Id}/edit"))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                       Disabled="@(!CanWithdraw(context.Status))"
                                       OnClick="@(() => WithdrawAsync(context.Id))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</MudStack>

@code {
    private List<ProjectProposal> proposals = new();
    private bool loading = true;
    private string? userId;

    private int ProposalCount => proposals.Count;
    private int ActiveProposalCount => proposals.Count(p => p.Status is ProposalStatus.Pending or ProposalStatus.UnderReview);
    private int MatchedProposalCount => proposals.Count(p => p.Status == ProposalStatus.Matched);
    private int WithdrawnProposalCount => proposals.Count(p => p.Status == ProposalStatus.Withdrawn);
    private ProjectProposal? LatestActiveProposal => proposals.FirstOrDefault(p => p.Status is ProposalStatus.Pending or ProposalStatus.UnderReview);
    private ProjectProposal? LatestMatchedProposal => proposals.FirstOrDefault(p => p.Status == ProposalStatus.Matched);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        proposals = await db.Proposals
            .Include(p => p.ResearchArea)
            .Where(p => p.OwnerUserId == userId)
            .OrderByDescending(p => p.UpdatedAt)
            .ToListAsync();
        loading = false;
    }

    private static bool CanEdit(ProposalStatus status) =>
        status is ProposalStatus.Pending or ProposalStatus.UnderReview;

    private static bool CanWithdraw(ProposalStatus status) =>
        status is ProposalStatus.Pending or ProposalStatus.UnderReview;

    private static Color StatusColor(ProposalStatus status) => status switch
    {
        ProposalStatus.Pending => Color.Info,
        ProposalStatus.UnderReview => Color.Warning,
        ProposalStatus.Matched => Color.Success,
        ProposalStatus.Withdrawn => Color.Dark,
        _ => Color.Default,
    };

    private async Task WithdrawAsync(int id)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = "Withdraw this proposal? You cannot undo this.",
            ["ButtonText"] = "Withdraw",
            ["Color"] = Color.Error,
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm withdraw", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        if (string.IsNullOrEmpty(userId)) return;
        var outcome = await Matching.WithdrawProposalAsync(userId, id);
        Snackbar.Add(outcome.Message, outcome.Succeeded ? Severity.Success : Severity.Error);
        if (outcome.Succeeded)
        {
            await LoadAsync();
        }
    }
}
