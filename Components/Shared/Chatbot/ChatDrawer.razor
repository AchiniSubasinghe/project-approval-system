@using System.Text
@using Microsoft.AspNetCore.Components.Authorization
@using project_approval_system.Services.Chatbot
@using project_approval_system.Services.Chatbot.Models

@inject IChatbotService Chatbot
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

@implements IDisposable

<MudDrawer Open="Open"
           OpenChanged="OnOpenChanged"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Width="420px"
           Elevation="4"
           OverlayAutoClose="true">
    <div class="chat-drawer">
        <div class="chat-header">
            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="ml-2">Blind-Match Assistant</MudText>
            <MudSpacer />
            <MudTooltip Text="Clear conversation">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Size="Size.Small"
                               Disabled="_isBusy"
                               OnClick="ClearHistory" />
            </MudTooltip>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           OnClick="() => OnOpenChanged(false)" />
        </div>

        <MudDivider />

        <div class="chat-messages" @ref="_messagesRef">
            @if (_history.Count == 0 && string.IsNullOrEmpty(_streamingText))
            {
                <div class="chat-welcome">
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        Ask me about your proposals, matches, or research areas. I can only read data — for actions, use the app pages.
                    </MudText>
                </div>
            }

            @foreach (var message in _history)
            {
                <ChatMessageView Message="message" />
            }

            @if (_isBusy)
            {
                <div class="chat-row chat-row-assistant">
                    <div class="chat-bubble chat-bubble-assistant">
                        @if (!string.IsNullOrEmpty(_streamingText))
                        {
                            <ChatMarkdown Text="@_streamingText" />
                        }
                        else
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        }
                        @foreach (var call in _activeToolCalls)
                        {
                            <MudChip T="string" Size="Size.Small" Color="@(call.Finished ? Color.Success : Color.Info)"
                                     Variant="Variant.Outlined"
                                     Icon="@(call.Finished ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Build)"
                                     Class="chat-tool-chip">
                                @call.Name
                            </MudChip>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">@_errorMessage</MudAlert>
            }
        </div>

        <MudDivider />

        <div class="chat-input">
            <MudTextField @bind-Value="_input"
                          Placeholder="Ask about your proposals, matches, supervisors..."
                          Variant="Variant.Outlined"
                          Lines="2"
                          MaxLines="4"
                          Immediate="true"
                          AutoFocus="true"
                          Disabled="_isBusy"
                          OnKeyDown="OnKeyDown"
                          Class="chat-input-field" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Send"
                       Disabled="_isBusy || string.IsNullOrWhiteSpace(_input)"
                       OnClick="SendAsync"
                       Class="mt-2">
                Send
            </MudButton>
        </div>
    </div>
</MudDrawer>

<style>
    .chat-drawer {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .chat-header {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
    }

    .chat-messages {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        background-color: var(--mud-palette-background-grey);
    }

    .chat-welcome {
        padding: 1.5rem 0.5rem;
        text-align: center;
        opacity: 0.75;
    }

    .chat-row {
        display: flex;
    }

    .chat-row-user { justify-content: flex-end; }
    .chat-row-assistant { justify-content: flex-start; }

    .chat-bubble {
        max-width: 88%;
        padding: 0.6rem 0.85rem;
        border-radius: 14px;
        font-size: 0.9rem;
        line-height: 1.4;
        box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }

    .chat-bubble-user {
        background-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
        border-bottom-right-radius: 4px;
    }

    .chat-bubble-assistant {
        background-color: var(--mud-palette-surface);
        color: var(--mud-palette-text-primary);
        border: 1px solid var(--mud-palette-lines-default);
        border-bottom-left-radius: 4px;
    }

    .chat-text {
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .chat-markdown {
        white-space: normal;
        overflow-x: auto;
    }

    .chat-markdown > :first-child {
        margin-top: 0;
    }

    .chat-markdown > :last-child {
        margin-bottom: 0;
    }

    .chat-markdown p,
    .chat-markdown ul,
    .chat-markdown ol,
    .chat-markdown pre,
    .chat-markdown blockquote,
    .chat-markdown table {
        margin: 0 0 0.65rem;
    }

    .chat-markdown ul,
    .chat-markdown ol {
        padding-left: 1.2rem;
    }

    .chat-markdown code {
        padding: 0.05rem 0.25rem;
        border-radius: 4px;
        background-color: var(--mud-palette-background-grey);
        font-size: 0.86em;
    }

    .chat-markdown pre {
        overflow-x: auto;
        padding: 0.6rem;
        border-radius: 6px;
        background-color: var(--mud-palette-background-grey);
    }

    .chat-markdown pre code {
        padding: 0;
        background-color: transparent;
    }

    .chat-markdown blockquote {
        padding-left: 0.75rem;
        border-left: 3px solid var(--mud-palette-lines-default);
        color: var(--mud-palette-text-secondary);
    }

    .chat-markdown table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
    }

    .chat-markdown th,
    .chat-markdown td {
        padding: 0.35rem 0.5rem;
        border: 1px solid var(--mud-palette-lines-default);
        text-align: left;
        vertical-align: top;
    }

    .chat-tool-chip {
        margin-top: 0.4rem;
        margin-right: 0.25rem;
    }

    .chat-input {
        padding: 0.75rem 1rem 1rem 1rem;
        display: flex;
        flex-direction: column;
    }

    .chat-input-field {
        flex: 1 1 auto;
    }
</style>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private readonly List<ChatMessage> _history = new();
    private readonly List<ActiveToolCall> _activeToolCalls = new();
    private string _input = string.Empty;
    private string _streamingText = string.Empty;
    private bool _isBusy;
    private string? _errorMessage;
    private ElementReference _messagesRef;
    private CancellationTokenSource? _cts;

    private System.Threading.Timer? _renderThrottle;
    private volatile bool _pendingRender;

    protected override void OnInitialized()
    {
        _renderThrottle = new System.Threading.Timer(OnRenderTick, null, Timeout.Infinite, Timeout.Infinite);
    }

    private async Task OnOpenChanged(bool value)
    {
        Open = value;
        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(value);
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _ = SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (_isBusy || string.IsNullOrWhiteSpace(_input))
        {
            return;
        }

        var text = _input.Trim();
        _input = string.Empty;
        _errorMessage = null;
        _streamingText = string.Empty;
        _activeToolCalls.Clear();
        _isBusy = true;
        StateHasChanged();

        _cts = new CancellationTokenSource();
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            var streamBuffer = new StringBuilder();

            await foreach (var ev in Chatbot.RunTurnAsync(_history, text, user, _cts.Token))
            {
                switch (ev)
                {
                    case TextDeltaEvent td:
                        streamBuffer.Append(td.Delta);
                        _streamingText = streamBuffer.ToString();
                        ScheduleRender();
                        break;
                    case ToolCallStartedEvent ts:
                        _activeToolCalls.Add(new ActiveToolCall(ts.ToolUseId, ts.ToolName, false));
                        ScheduleRender();
                        break;
                    case ToolCallFinishedEvent tf:
                        {
                            var existing = _activeToolCalls.FirstOrDefault(c => c.Id == tf.ToolUseId);
                            if (existing is not null)
                            {
                                existing.Finished = true;
                            }
                            ScheduleRender();
                            break;
                        }
                    case AssistantMessageCompletedEvent:
                        streamBuffer.Clear();
                        _streamingText = string.Empty;
                        await InvokeAsync(StateHasChanged);
                        break;
                    case TurnErrorEvent err:
                        _errorMessage = err.Message;
                        break;
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _errorMessage = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            _streamingText = string.Empty;
            _activeToolCalls.Clear();
            _cts?.Dispose();
            _cts = null;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottomAsync();
        }
    }

    private void ScheduleRender()
    {
        _pendingRender = true;
        _renderThrottle?.Change(50, Timeout.Infinite);
    }

    private void OnRenderTick(object? _)
    {
        if (!_pendingRender)
        {
            return;
        }
        _pendingRender = false;
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await ScrollToBottomAsync();
        });
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                "(function(){var el=document.querySelector('.chat-messages'); if(el){el.scrollTop=el.scrollHeight;}})()");
        }
        catch
        {
        }
    }

    private void ClearHistory()
    {
        if (_isBusy)
        {
            return;
        }
        _history.Clear();
        _streamingText = string.Empty;
        _errorMessage = null;
        _activeToolCalls.Clear();
        StateHasChanged();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _renderThrottle?.Dispose();
    }

    private sealed class ActiveToolCall
    {
        public ActiveToolCall(string id, string name, bool finished)
        {
            Id = id;
            Name = name;
            Finished = finished;
        }
        public string Id { get; }
        public string Name { get; }
        public bool Finished { get; set; }
    }
}
