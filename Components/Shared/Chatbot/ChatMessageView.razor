@namespace project_approval_system.Components.Shared.Chatbot
@using project_approval_system.Services.Chatbot.Models

@if (Message is not null && HasRenderableContent)
{
    <div class="chat-row @(IsUser ? "chat-row-user" : "chat-row-assistant")">
        <div class="chat-bubble @(IsUser ? "chat-bubble-user" : "chat-bubble-assistant")">
            @foreach (var block in Message.Content)
            {
                switch (block.Type)
                {
                    case ChatContentType.Text when !string.IsNullOrWhiteSpace(block.Text):
                        if (IsUser)
                        {
                            <div class="chat-text">@block.Text</div>
                        }
                        else
                        {
                            <ChatMarkdown Text="@block.Text" />
                        }
                        break;
                    case ChatContentType.ToolUse:
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Build" Class="chat-tool-chip">
                            @block.ToolName
                        </MudChip>
                        @if (PendingActions is not null
                             && !string.IsNullOrEmpty(block.ToolUseId)
                             && PendingActions.TryGetValue(block.ToolUseId, out var pending))
                        {
                            <PendingActionCard State="pending"
                                               Disabled="PendingDisabled"
                                               OnConfirm="OnConfirm"
                                               OnCancel="OnCancel" />
                        }
                        break;
                }
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ChatMessage? Message { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, PendingActionState>? PendingActions { get; set; }

    [Parameter]
    public bool PendingDisabled { get; set; }

    [Parameter]
    public EventCallback<string> OnConfirm { get; set; }

    [Parameter]
    public EventCallback<string> OnCancel { get; set; }

    private bool IsUser => Message?.Role == ChatRole.User;

    private bool HasRenderableContent => Message?.Content.Any(c =>
        (c.Type == ChatContentType.Text && !string.IsNullOrWhiteSpace(c.Text))
        || c.Type == ChatContentType.ToolUse) == true;
}
